import flixel.FlxG;
import flixel.text.FlxText;
import flixel.util.FlxColor;
import funkin.ui.MusicBeatState;
import funkin.ui.mainmenu.MainMenuState;

/**
 * v0.8.6 isolation state.
 *
 * Keep this class limited to compiled engine types until its construction is
 * confirmed in the real game. The editor features will then be restored one
 * dependency at a time; do not add SIT* field or signature types here yet.
 */
class SITSongImporterEditorState extends MusicBeatState
{
  public function new()
  {
    super();
  }

  override function create():Void
  {
    // MusicBeatState installs its normal state lifecycle and camera-dependent
    // UI before this state customizes the already-created primary camera.
    super.create();

    FlxG.camera.bgColor = 0xFF12151C;

    var text = new FlxText(0, 0, FlxG.width,
      'Song Importer works!\nESC to return.', 32);
    text.screenCenter();
    text.alignment = 'center';
    text.color = FlxColor.WHITE;
    add(text);

    trace('[Song Importer] Minimal v0.8.6 editor state created successfully.');
  }

  override function update(elapsed:Float):Void
  {
    super.update(elapsed);

    if (FlxG.keys.justPressed.ESCAPE)
    {
      // MainMenuState is compiled, so the standard deferred constructor form
      // used throughout v0.8.6 is appropriate here.
      FlxG.switchState(() -> new MainMenuState());
    }
  }
}
