/** Temporary deterministic 0,1,2,3 rotation. Replace without touching UI. */
class SITLaneAssigner
{
  public function new() {}

  public function assign(events:Array<SITAnalysisEvent>):Array<Int>
  {
    var lanes:Array<Int> = [];
    var nextLane:Int = 0;
    for (event in events)
    {
      lanes.push(nextLane);
      nextLane = (nextLane + 1) % 4;
    }
    return lanes;
  }
}

